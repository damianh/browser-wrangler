<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BrowserWrangler.Linux</RootNamespace>
    <AssemblyName>browser-wrangler</AssemblyName>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">stable</ReleaseChannel>
    <DefineConstants Condition="'$(ReleaseChannel)' == 'dev'">$(DefineConstants);DEV_CHANNEL</DefineConstants>
    <!-- Version is stamped by CI as YYYY.MMDD.buildrun -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Product>Browser Wrangler</Product>
    <Authors>Damian Hickey</Authors>
    <Company>Damian Hickey</Company>
    <Copyright>© 2026 Damian Hickey</Copyright>
    <Description>Redirects URLs you click to the right browser and profile, based on rules you define.</Description>
    <RepositoryUrl>https://github.com/damianh/browser-wrangler</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Surfaced on the About page. -->
    <AssemblyMetadata
      Include="AvaloniaVersion"
      Value="@(PackageReference->WithMetadataValue('Identity','Avalonia')->'%(Version)')" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\logo-256.png" Link="logo-256.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <AvaloniaResource Include="Assets\logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrowserWrangler.Core\BrowserWrangler.Core.csproj" />
  </ItemGroup>
</Project>
