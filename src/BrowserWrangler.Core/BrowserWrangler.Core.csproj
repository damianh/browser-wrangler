<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
    <!-- managed providers only; the e_sqlite3 native library is shipped by the Linux host -->
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" Version="3.0.5" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
