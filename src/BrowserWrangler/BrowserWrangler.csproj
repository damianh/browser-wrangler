<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BrowserWrangler</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">stable</ReleaseChannel>
    <DefineConstants Condition="'$(ReleaseChannel)' == 'dev'">$(DefineConstants);DEV_CHANNEL</DefineConstants>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Version is stamped by CI as YYYY.MMDD.buildrun -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Product>Browser Wrangler</Product>
    <Authors>Damian Hickey</Authors>
    <Company>Damian Hickey</Company>
    <Copyright>© 2026 Damian Hickey</Copyright>
    <Description>Redirects URLs you click to the right browser and profile, based on rules you define.</Description>
    <RepositoryUrl>https://github.com/damianh/browser-wrangler</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Surfaced on the About page; the runtime assemblies only expose the WinUI version. -->
    <AssemblyMetadata
      Include="WindowsAppSdkVersion"
      Value="@(PackageReference->WithMetadataValue('Identity','Microsoft.WindowsAppSDK')->'%(Version)')" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo-256.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrowserWrangler.Core\BrowserWrangler.Core.csproj" />
  </ItemGroup>
</Project>
